# ---------------------------------------------------------------------------
# Forno Pizza Co. restaurant POS API — example configuration.
# Copy to `.env` (which is gitignored) and adjust for your environment.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Bind to loopback for a single-machine install; use 0.0.0.0 only when
# restaurant LAN terminals must reach this server directly.
HOST=127.0.0.1
PORT=4000

# --- PostgreSQL ------------------------------------------------------------
# The bundled dev database runs on port 55432 (see scripts/pg-dev.mjs) so it
# never collides with a machine-wide PostgreSQL service on 5432.
DATABASE_URL="postgresql://posshope_admin:CHANGE_ME@127.0.0.1:55432/corner_pizza?schema=public"
# Integration tests use a separate database so they can truncate freely.
TEST_DATABASE_URL="postgresql://posshope_admin:CHANGE_ME@127.0.0.1:55432/corner_pizza_test?schema=public"

# Supabase (production / Vercel):
# The API uses the transaction pooler; migrations use the direct connection.
# DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Authentication ---------------------------------------------------------
# MUST be replaced with a long random value in production (>= 32 chars).
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=43200
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins trusted to call the API with credentials,
# e.g. https://pos.example.com. Outside production every origin is trusted.
# In production `*` only allows credential-less reads — list the web origin.
CORS_ORIGINS=*
# The web session cookie is `Secure` in production by default. Set to false
# only when serving the web app over plain HTTP on a trusted LAN.
# WEB_COOKIE_SECURE=true

# --- Operations ------------------------------------------------------------
LOG_LEVEL=info
BUSINESS_TIMEZONE=Africa/Cairo

# --- Basata payment gateway ------------------------------------------------
# Leave the keys empty to keep online card payments in simulation mode.
# BASATA_BASE_URL=https://api.basata.example
# BASATA_API_KEY=
# BASATA_MERCHANT_ID=
# BASATA_WEBHOOK_SECRET=
# BASATA_CHECKOUT_RETURN_URL=https://order.forno.local/checkout/return
# Simulation is allowed automatically outside production; set false to disable.
# BASATA_ALLOW_SIMULATION=true

# --- Geocoding (optional) -------------------------------------------------
# Nominatim-compatible endpoint for address-only delivery checks.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Cloudinary (menu image uploads) --------------------------------------
# Create a Cloudinary product environment and copy the credentials from the
# dashboard. Uploads are stored under CLOUDINARY_UPLOAD_FOLDER.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=corner-pizza

# --- Windows POS installer (website /download page) -----------------------
# Public link to CornerPOS-Setup.exe (e.g. a GitHub release asset or a public
# storage bucket). Leave empty to show "not published yet" on /download.
# DESKTOP_DOWNLOAD_URL=https://example.com/CornerPOS-Setup-0.1.5.exe
# DESKTOP_VERSION=0.1.5
# DESKTOP_SHA256=
